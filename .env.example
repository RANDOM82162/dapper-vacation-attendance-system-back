# Copia este archivo como .env. Nunca publiques .env ni las cuentas de servicio.
PORT=8080
CONNECTION_STRING=mongodb://localhost:27018/dapper-vacation-attendance-system-db
DB_NAME=dapper-vacation-attendance-system-db
NODE_ENV=development

# Orígenes exactos del frontend permitidos por CORS (separados por coma).
# En producción agrega el origen del ERP/frontend.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
API_RATE_LIMIT_MAX=1200
# Configura los saltos del proxy confiable solo si el backend está detrás de uno.
# TRUST_PROXY_HOPS=1

# Firebase Admin: usa credenciales de servicio o Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
USE_FIREBASE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_BUCKET=
LOG_LEVEL=info

# Correos de Brevo. Déjalos desactivados hasta configurar sus plantillas.
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_NAME=Dapper RH
BREVO_SENDER_EMAIL=
BREVO_TEMPLATE_VACATION_REQUEST_CREATED_ID=
BREVO_TEMPLATE_VACATION_STATUS_CHANGED_ID=
BREVO_TEMPLATE_NEW_USER_CREDENTIALS_ID=
BREVO_TEMPLATE_NEW_USER_ADMIN_ID=

# Google Calendar es opcional.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
