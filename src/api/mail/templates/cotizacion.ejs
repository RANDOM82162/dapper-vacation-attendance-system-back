<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    /* Reset básico */
    body { margin: 0; padding: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f1f5f9; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
    
    /* Media Query para Móviles */
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      .mobile-padding { padding: 20px !important; }
      .mobile-stack { display: block !important; width: 100% !important; box-sizing: border-box !important; }
      .mobile-center { text-align: center !important; }
      .mobile-left { text-align: left !important; }
      .mobile-mt { margin-top: 20px !important; }
      .mobile-mb { margin-bottom: 20px !important; }
      .mobile-pr-0 { padding-right: 0 !important; }
      
      /* Ajuste específico para la tabla de ítems en pantallas muy pequeñas */
      .item-cell { padding: 10px 4px !important; font-size: 11px !important; }
    }
  </style>
</head>
<body style="background-color: #f1f5f9; margin: 0; padding: 20px;">
  
  <div class="container" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">

    <div style="background-color: #ffffff; padding: 30px; border-bottom: 2px solid #f1f5f9;">
      <p style="color: #64748b; font-size: 14px; font-weight: bold; text-transform: uppercase; margin-bottom: 10px;">Envio de vista previa de cotización</p>
      <p style="color: #334155; font-size: 16px; line-height: 1.6; margin: 0;">
        <%= message.replace(/\n/g, '<br>') %>
      </p>
    </div>

    <div style="background-color: #052651; padding: 32px; color: #ffffff;">
      <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td class="mobile-stack mobile-center mobile-mb" valign="top" width="50%">
            <div style="font-size: 24px; font-weight: 900; letter-spacing: -0.025em; color: #ffffff;">+ Conta</div>
            <div style="color: #cbd5e1; font-size: 12px; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; margin-top: 10px;">
              <%= cotizacion.contribuyente?.nombre || 'EMPRESA EMISORA' %>
            </div>
            <div style="color: #94a3b8; font-size: 12px; margin-top: 4px;">
              <%= cotizacion.contribuyente?.rfc || 'RFC GENÉRICO' %>
            </div>
          </td>
          <td class="mobile-stack mobile-center" valign="top" width="50%" style="text-align: right;">
            <h1 style="font-size: 30px; font-weight: 700; text-transform: uppercase; margin: 0 0 4px 0; color: #ffffff;">Cotización</h1>
            <p style="color: #3b82f6; font-size: 18px; font-weight: 700; margin: 0;">#<%= cotizacion.folio %></p>
            <p style="color: #94a3b8; font-size: 14px; margin: 4px 0 0 0;">Fecha: <%= new Date(cotizacion.fecha).toLocaleDateString('es-MX') %></p>
          </td>
        </tr>
      </table>
    </div>

    <div class="mobile-padding" style="padding: 40px;">
      
      <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 40px; border-bottom: 1px solid #f1f5f9; padding-bottom: 24px;">
        <tr>
          <td class="mobile-stack mobile-left mobile-mb" valign="bottom" width="50%">
            <label style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #94a3b8; display: block; margin-bottom: 4px;">Preparado para:</label>
            <div style="font-size: 20px; font-weight: 700; color: #1e293b;"><%= cotizacion.cliente?.nombre || 'CLIENTE MOSTRADOR' %></div>
            <div style="font-size: 14px; color: #64748b; margin-top: 4px;"><%= cotizacion.cliente?.razon_social %></div>
          </td>
          <td class="mobile-stack mobile-left" valign="bottom" width="50%" style="text-align: right;">
            <label style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #94a3b8; display: block; margin-bottom: 4px;">Atendido por:</label>
            <div style="font-size: 14px; font-weight: 600; color: #334155;"><%= cotizacion.creadoPor?.nombre || 'Agente de Ventas' %></div>
          </td>
        </tr>
      </table>

      <div style="margin-bottom: 32px; background-color: #f8fafc; border-left: 4px solid #2563eb; padding: 12px 16px; border-radius: 0 4px 4px 0;">
        <p style="font-size: 14px; color: #475569; font-style: italic; margin: 0;">
          "<%= cotizacion.conceptoGeneral || 'Servicios generales descritos a continuación.' %>"
        </p>
      </div>

      <div style="margin-bottom: 40px; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table width="100%" cellpadding="0" cellspacing="0">
          <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
            <tr>
              <th class="item-cell" style="padding: 16px; text-align: center; font-size: 12px; color: #64748b; text-transform: uppercase;">Cant.</th>
              <th class="item-cell" style="padding: 16px; text-align: left; font-size: 12px; color: #64748b; text-transform: uppercase;">Descripción</th>
              <th class="item-cell" style="padding: 16px; text-align: right; font-size: 12px; color: #64748b; text-transform: uppercase;">Precio</th>
              <th class="item-cell" style="padding: 16px; text-align: right; font-size: 12px; color: #64748b; text-transform: uppercase;">Importe</th>
            </tr>
          </thead>
          <tbody>
            <% cotizacion.items.forEach(function(item, index) { %>
              <tr style="background-color: <%= index % 2 === 0 ? '#ffffff' : '#fcfcfc' %>;">
                <td class="item-cell" style="padding: 16px; text-align: center; color: #0f172a; font-weight: 500;"><%= item.cantidad %></td>
                <td class="item-cell" style="padding: 16px; text-align: left; color: #475569; font-weight: 500;"><%= item.nombre %></td>
                <td class="item-cell" style="padding: 16px; text-align: right; color: #475569;"><%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(item.precioUnitario) %></td>
                <td class="item-cell" style="padding: 16px; text-align: right; color: #0f172a; font-weight: 700;"><%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(item.cantidad * item.precioUnitario) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td class="mobile-stack mobile-pr-0" valign="top" width="60%" style="padding-right: 40px;">
            <h4 style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 12px;">Información de Pago</h4>
            <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; font-size: 12px; color: #475569;">
              <% if (cotizacion.banco) { %>
                <div style="margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <strong style="color: #334155;">Clave:</strong> <%= cotizacion.banco['Clave'] || 'N/A' %>
                </div>
                <div style="margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <strong style="color: #334155;">Banco:</strong> <%= cotizacion.banco['Nombre corto'] || 'N/A' %>
                </div>
                <div>
                  <strong style="color: #334155;">Razón Social:</strong> 
                  <span style="font-family: monospace; background-color: #ffffff; padding: 2px 6px; border: 1px solid #e2e8f0; border-radius: 4px; display: inline-block;"><%= cotizacion.banco['Nombre o razón social'] || 'N/A' %></span>
                </div>
              <% } else { %>
                <div style="text-align: center; padding: 10px 0; color: #94a3b8; font-style: italic;">
                  No se ha seleccionado información bancaria
                </div>
              <% } %>
            </div>
            
            <div style="margin-top: 24px;">
              <h4 style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 8px;">Notas</h4>
              <p style="font-size: 12px; color: #64748b; line-height: 1.6;">
                <%= (cotizacion.notas && cotizacion.notas !== 'si') ? cotizacion.notas : 'Precios sujetos a cambio sin previo aviso.' %>
              </p>
            </div>
          </td>

          <td class="mobile-stack mobile-mt" valign="top" width="40%">
            <table width="100%" cellpadding="0" cellspacing="0" style="font-size: 14px;">
              <tr>
                <td style="padding-bottom: 8px; color: #64748b;">Subtotal</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 500; color: #64748b;">
                   <%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(cotizacion.subtotal) %>
                </td>
              </tr>
              
              <% if (cotizacion.descuento > 0) { %>
              <tr>
                <td style="padding-bottom: 8px; color: #ef4444;">Descuento (<%= cotizacion.descuento %>%)</td>
                <td style="padding-bottom: 8px; text-align: right; color: #ef4444;">
                  - <%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(cotizacion.subtotal - cotizacion.subtotalDescuento) %>
                </td>
              </tr>
              <% } %>

              <tr>
                <td style="padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; color: #64748b;">IVA (16%)</td>
                <td style="padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; text-align: right; font-weight: 500; color: #64748b;">
                  <%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(cotizacion.iva) %>
                </td>
              </tr>

              <tr>
                <td style="padding-top: 12px; font-size: 18px; font-weight: 700; color: #1e293b;">TOTAL</td>
                <td style="padding-top: 12px; text-align: right; font-size: 24px; font-weight: 900; color: #2563eb;">
                  <%= new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(cotizacion.total) %>
                </td>
              </tr>
              <tr>
                <td colspan="2" style="text-align: right; font-size: 10px; color: #94a3b8; text-transform: uppercase; font-weight: 500; padding-top: 4px;">
                  Moneda Nacional
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <div class="mobile-mt" style="margin-top: 60px; padding-top: 32px; border-top: 1px solid #e2e8f0;">
        <table width="100%">
          <tr>
            <td class="mobile-stack mobile-mb" width="50%" valign="bottom" style="font-size: 12px; color: #64748b;">
              <p style="margin-bottom: 32px;">Acepto términos y condiciones.</p>
              <div style="height: 1px; width: 80%; background-color: #cbd5e1; margin-bottom: 8px;"></div>
              <p style="margin: 0;">Firma de Conformidad</p>
            </td>
            <td class="mobile-stack mobile-left" width="50%" valign="bottom" style="text-align: right; font-size: 12px;">
              <p style="font-weight: 700; color: #1e293b; text-transform: uppercase; margin: 0;">
                <%= cotizacion.contribuyente?.nombre || 'Juan M. Arroyo Figueroa' %>
              </p>
              <p style="color: #64748b; margin: 4px 0;">Director de Operaciones</p>
              <p style="color: #94a3b8; font-size: 10px; margin-top: 4px;">Generado digitalmente por +Conta</p>
            </td>
          </tr>
        </table>
      </div>

    </div>
  </div>
  
  </body>
</html>